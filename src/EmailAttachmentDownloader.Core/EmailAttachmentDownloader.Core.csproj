<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EmailAttachmentDownloader.Core</RootNamespace>
    <Description>Mail fetching, attachment saving, de-duplication and scheduling for Email Attachment Downloader. No UI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating ranges for the first build; pin exact versions once the first restore succeeds. -->
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmailAttachmentDownloader.Core.Tests" />
  </ItemGroup>

</Project>
