<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>EmailAttachmentDownloader</AssemblyName>
    <RootNamespace>EmailAttachmentDownloader.Tray</RootNamespace>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\app-icon.ico" LogicalName="app-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailAttachmentDownloader.Core\EmailAttachmentDownloader.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.*" />
    <!-- Draws the pairing QR code for the iPhone app. Floating like the other packages until the first restore succeeds. -->
    <PackageReference Include="QRCoder" Version="1.*" />
  </ItemGroup>

</Project>
